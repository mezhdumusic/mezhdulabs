---
import ShareButton from './ShareButton.astro';

interface Card { date?: string; title?: string; excerpt?: string; action?: string; href?: string; videoUrl?: string; embedUrl?: string; embedUrlDark?: string; embedHeight?: number; embedHref?: string; readingTime?: string; shareLabel?: string; shareCopiedLabel?: string; shareFailedLabel?: string; }
interface Props { cards: readonly Card[]; variant?: 'article' | 'video' | 'music'; ariaLabel?: string; videoTitle?: string; }
const { cards, variant = 'article', ariaLabel = 'Content', videoTitle = 'Video' } = Astro.props;
const rows = Array.from({ length: Math.ceil(cards.length / 2) }, (_, index) => cards.slice(index * 2, index * 2 + 2));
---

<section class:list={['grid-page', `grid-page--${variant}`]} aria-label={ariaLabel}>
  <div class="card-grid">
    {rows.map((row) => (
      <div class="card-row">
        {row.map((card) => (
          <article class:list={['content-card', `content-card--${variant}`]}>
            {variant === 'video' ? (
              <div class="video-embed">
                <span class="video-skeleton" aria-hidden="true"><span class="skeleton-play"></span></span>
                <span class="sr-only">{card.excerpt}</span>
                <iframe src={card.videoUrl} title={videoTitle} loading="lazy" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen></iframe>
              </div>
            ) : variant === 'music' ? (
              <div class="music-embed" style={`aspect-ratio: 350 / ${card.embedHeight ?? 470};`}>
                <iframe
                  style="border: 0; width: 100%; height: 100%;"
                  src={card.embedUrl}
                  data-light-src={card.embedUrl}
                  data-dark-src={card.embedUrlDark ?? card.embedUrl}
                  title={card.title}
                  loading="lazy"
                  seamless
                ></iframe>
              </div>
            ) : (
              <>
                <a class="content-card-link" href={card.href ?? '#'}>
                  <h2>{card.title}</h2>
                  <p>{card.excerpt}</p>
                </a>
                <div class="content-card-divider" aria-hidden="true"></div>
                <div class="content-card-meta">
                  <span class="content-card-meta-text">
                    <time>{card.date}</time>
                    {card.readingTime && <span class="meta-separator" aria-hidden="true">&middot;</span>}
                    {card.readingTime && <span>{card.readingTime}</span>}
                  </span>
                  <ShareButton
                    url={card.href ?? ''}
                    label={card.shareLabel ?? ''}
                    copiedLabel={card.shareCopiedLabel ?? ''}
                    failedLabel={card.shareFailedLabel ?? ''}
                  />
                </div>
                <div class="content-card-divider" aria-hidden="true"></div>
              </>
            )}
          </article>
        ))}
      </div>
    ))}
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('.video-embed').forEach((embed) => {
    const iframe = embed.querySelector<HTMLIFrameElement>('iframe');
    if (!iframe || embed.dataset.initialized) return;
    embed.dataset.initialized = 'true';
    iframe.addEventListener('load', () => embed.classList.add('is-loaded'), { once: true });
  });

  const musicIframes = document.querySelectorAll<HTMLIFrameElement>('.music-embed iframe[data-dark-src]');
  const updateMusicTheme = () => {
    const isDark = document.documentElement.dataset.theme === 'dark';
    musicIframes.forEach((iframe) => {
      const nextSrc = isDark ? iframe.dataset.darkSrc : iframe.dataset.lightSrc;
      if (nextSrc && iframe.getAttribute('src') !== nextSrc) iframe.setAttribute('src', nextSrc);
    });
  };

  updateMusicTheme();
  if (musicIframes.length) {
    new MutationObserver(updateMusicTheme).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
  }
</script>

<style>
  .grid-page { padding: 80px 20px 40px; }
  .card-grid { width: min(100%, 1040px); margin: 0 auto; }
  .card-row { display: grid; grid-template-columns: repeat(2, minmax(340px, 1fr)); gap: 40px; padding-bottom: 0; border-bottom: 1px solid var(--site-line); }
  .card-row + .card-row { padding-top: 40px; }
  .grid-page--video .card-row,
  .grid-page--music .card-row { min-height: 0; padding-bottom: 0 !important; border-bottom: 0 !important; }
  .grid-page--article .card-row { border-bottom: 0; }
  .grid-page--video .card-row,
  .grid-page--music .card-row { gap: 10px; }
  .grid-page--video .card-row + .card-row,
  .grid-page--music .card-row + .card-row { padding-top: 10px !important; }
  .grid-page--video .content-card,
  .grid-page--music .content-card { min-height: 0; padding: 0; }
  .content-card { display: flex; min-width: 340px; min-height: 210px; padding: 10px; flex-direction: column; align-items: flex-start; }
  .content-card h2 { max-width: 390px; margin: 19px 0 14px; font-size: 1.5rem; font-weight: 600; line-height: 1.05; }
  .content-card p { max-width: 420px; margin: 0; color: var(--site-muted); font-size: .875rem; line-height: 1.45; }
  .content-card--article { padding: 0; }
  .content-card--article .content-card-link { padding: 10px 10px 20px; }
  .content-card--article p { font-family: var(--font-heading); font-size: 1rem; }
  .content-card--article h2,
  .content-card--article p { max-width: 100%; width: 100%; }
  .content-card--article h2 { margin: 0 0 14px; font-size: clamp(1.25rem, 1rem + 1.2vw, 1.75rem); font-weight: 700; line-height: 1.2; min-height: 2.4em; }
  .content-card-divider { width: 100%; height: 1px; background: var(--divider-line); }
  .content-card-meta { display: flex; width: 100%; align-items: center; justify-content: space-between; padding: 10px; }
  .content-card-meta-text { display: flex; align-items: center; gap: 10px; color: var(--site-subtle); font-size: .8rem; letter-spacing: .28em; line-height: 1; }
  .content-card-meta-text .meta-separator { color: var(--site-subtle); }
  .music-embed { display: flex; width: 100%; overflow: hidden; }
  .music-embed iframe { display: block; width: 100%; height: 100%; }
  .video-embed { position: relative; width: 100%; aspect-ratio: 16 / 9; margin-bottom: 20px; overflow: hidden; background: #101010; }
  .grid-page--video .video-embed { margin-bottom: 0; }
  .video-embed iframe { position: relative; z-index: 1; display: block; width: 100%; height: 100%; border: 0; opacity: 0; transition: opacity 500ms ease; }
  .video-embed.is-loaded iframe { opacity: 1; }
  .video-skeleton { position: absolute; inset: 0; display: grid; place-items: center; overflow: hidden; background: linear-gradient(115deg, #e5e5e5 0%, #eeeeee 38%, #fafafa 50%, #eeeeee 62%, #e5e5e5 100%); background-size: 220% 100%; animation: video-shimmer 1.8s ease-in-out infinite; transition: opacity 400ms ease; }
  .video-skeleton::after { content: ''; position: absolute; inset: 0; background: radial-gradient(circle at 50% 50%, rgb(255 255 255 / 65%), transparent 30%); }
  .skeleton-play { position: relative; z-index: 1; display: block; width: 58px; height: 42px; border-radius: 13px; background: rgb(17 17 17 / 8%); box-shadow: 0 0 0 10px rgb(17 17 17 / 3%); animation: video-pulse 1.8s ease-in-out infinite; }
  .skeleton-play::after { content: ''; position: absolute; top: 11px; left: 25px; border-top: 10px solid transparent; border-bottom: 10px solid transparent; border-left: 14px solid rgb(17 17 17 / 30%); }
  .video-embed.is-loaded .video-skeleton { opacity: 0; pointer-events: none; }
  @keyframes video-shimmer { 0% { background-position: 100% 0; } 50%, 100% { background-position: 0 0; } }
  @keyframes video-pulse { 0%, 100% { transform: scale(.94); opacity: .65; } 50% { transform: scale(1); opacity: 1; } }
  @media (prefers-reduced-motion: reduce) { .video-skeleton, .skeleton-play { animation: none; } }
  :global(:root[data-theme='dark']) .video-skeleton { background: linear-gradient(115deg, #252525 0%, #303030 38%, #414141 50%, #303030 62%, #252525 100%); background-size: 220% 100%; }
  :global(:root[data-theme='dark']) .skeleton-play { background: rgb(255 255 255 / 8%); box-shadow: 0 0 0 10px rgb(255 255 255 / 3%); }
  :global(:root[data-theme='dark']) .skeleton-play::after { border-left-color: rgb(255 255 255 / 35%); }
  :global(:root[data-theme='dark']) .video-skeleton::after { background: none; }
  .content-card-link { display: flex; width: 100%; height: 100%; flex-direction: column; align-items: flex-start; color: inherit; text-decoration: none; }
  .content-card--article .content-card-link { height: auto; }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }

  @media (max-width: 740px) {
    .grid-page { padding-top: 40px; }
    .card-row { grid-template-columns: minmax(340px, 1fr); gap: 20px; padding-bottom: 0; border-bottom: 0; }
    .card-row + .card-row { padding-top: 20px; }
    .grid-page--video .card-row,
    .grid-page--music .card-row { padding-bottom: 0 !important; border-bottom: 0 !important; }
    .grid-page--video .card-row { gap: 10px; }
    .grid-page--music .card-row { gap: 10px; }
    .grid-page--video .card-row + .card-row,
    .grid-page--music .card-row + .card-row { padding-top: 10px !important; }
    .grid-page--video .content-card,
    .grid-page--music .content-card { min-height: 0; border-bottom: 0; }
    .grid-page--video .content-card { padding: 0; }
    .content-card { min-width: 340px; min-height: 210px; padding-bottom: 20px; border-bottom: 1px solid var(--site-line); }
    .grid-page--article .content-card { padding-bottom: 0; border-bottom: 0; }
  }

  @media (max-width: 380px) {
    .grid-page { padding-right: 10px; padding-left: 10px; }
    .content-card, .card-row { min-width: 0; }
  }
</style>

---
import NavBar from './NavBar.astro';
import { ui, withBase, type Locale } from '../lib/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const labels = ui[locale];
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <link rel="icon" type="image/svg+xml" href={withBase('favicon.svg')} />
    <meta name="viewport" content="width=device-width" />
    <title>{labels.siteTitle}</title>
    <script is:inline>
      (() => {
        try {
          const theme = localStorage.getItem('theme');
          if (theme === 'dark' || theme === 'light') document.documentElement.dataset.theme = theme;
        } catch {}
      })();
    </script>
  </head>
  <body>
    <NavBar locale={locale} />
    <main><slot /></main>
  </body>
</html>

<style is:global>
  @import url('https://fonts.googleapis.com/css2?family=Sofia+Sans+Semi+Condensed:wght@400;500;600&family=Lora:ital,wght@0,400;0,500;0,600;1,400&display=swap');
  :root {
    --site-surface: #fff;
    --site-ink: #111;
    --site-muted: rgb(17 17 17 / 65%);
    --site-subtle: rgb(17 17 17 / 55%);
    --site-line: rgb(0 0 0 / 25%);
    --divider-line: rgb(0 0 0 / 10%);
    --site-hover: rgb(17 17 17 / 7%);
    --waveform-muted: rgb(17 17 17 / 25%);
    --font-heading: 'Sofia Sans Semi Condensed', sans-serif;
    --font-body: 'Lora', serif;
    font-family: var(--font-heading);
    background: var(--site-surface);
    color: var(--site-ink);
    color-scheme: light;
  }
  :root[data-theme='dark'] {
    --site-surface: #121212;
    --site-ink: #f5f5f5;
    --site-muted: rgb(245 245 245 / 65%);
    --site-subtle: rgb(245 245 245 / 55%);
    --site-line: rgb(245 245 245 / 25%);
    --divider-line: rgb(245 245 245 / 10%);
    --site-hover: rgb(245 245 245 / 10%);
    --waveform-muted: rgb(245 245 245 / 25%);
    color-scheme: dark;
  }
  * { box-sizing: border-box; }
  html { overflow-y: scroll; scrollbar-gutter: stable; }
  html, body { margin: 0; min-width: 320px; background: var(--site-surface); color: var(--site-ink); transition: background-color 180ms ease, color 180ms ease; }
  body { padding-top: 65px; }
  main { min-height: calc(100vh - 65px); }
</style>

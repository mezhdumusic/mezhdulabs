---
interface Props {
  url: string;
  label: string;
  copiedLabel: string;
  failedLabel: string;
}

const { url, label, copiedLabel, failedLabel } = Astro.props;
---

<span class="share-control">
  <button
    class="share-button"
    type="button"
    aria-label={label}
    data-copy-link
    data-share-url={url}
    data-copied-label={copiedLabel}
    data-failed-label={failedLabel}
  >
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <path d="M12 14V3" />
      <path d="m7 8 5-5 5 5" />
      <path d="M5 13v7h14v-7" />
    </svg>
  </button>
  <span class="share-badge" role="status" aria-live="polite" hidden></span>
</span>

<script>
  const fallbackCopy = (value: string) => {
    const textarea = document.createElement('textarea');
    textarea.value = value;
    textarea.setAttribute('readonly', '');
    textarea.style.position = 'fixed';
    textarea.style.opacity = '0';
    document.body.append(textarea);
    textarea.select();
    const copied = document.execCommand('copy');
    textarea.remove();
    if (!copied) throw new Error('Copy command failed');
  };

  document.querySelectorAll<HTMLButtonElement>('[data-copy-link]').forEach((button) => {
    if (button.dataset.initialized) return;
    button.dataset.initialized = 'true';
    const control = button.closest<HTMLElement>('.share-control');
    const badge = control?.querySelector<HTMLElement>('.share-badge');
    let hideTimer: number | undefined;

    button.addEventListener('click', async () => {
      const rawUrl = button.dataset.shareUrl ?? window.location.href;
      const url = new URL(rawUrl, window.location.href).href;
      const message = button.dataset.copiedLabel ?? 'Link copied';
      const failedMessage = button.dataset.failedLabel ?? 'Could not copy link';
      try {
        if (navigator.clipboard?.writeText) await navigator.clipboard.writeText(url);
        else fallbackCopy(url);
        if (badge) {
          badge.textContent = message;
          badge.hidden = false;
          requestAnimationFrame(() => badge.classList.add('is-visible'));
          window.clearTimeout(hideTimer);
          hideTimer = window.setTimeout(() => {
            badge.classList.remove('is-visible');
            window.setTimeout(() => { badge.hidden = true; }, 180);
          }, 2200);
        }
      } catch {
        if (badge) {
          badge.textContent = failedMessage;
          badge.hidden = false;
          badge.classList.add('is-visible');
          window.clearTimeout(hideTimer);
          hideTimer = window.setTimeout(() => {
            badge.classList.remove('is-visible');
            window.setTimeout(() => { badge.hidden = true; }, 180);
          }, 2200);
        }
      }
    });
  });
</script>

<style>
  .share-control { position: relative; display: inline-flex; align-items: center; }
  .share-button { display: grid; width: 36px; height: 36px; padding: 0; place-items: center; border: 0; background: transparent; color: var(--site-ink); cursor: pointer; }
  .share-button svg { width: 20px; height: 20px; fill: none; stroke: currentColor; stroke-linecap: round; stroke-linejoin: round; stroke-width: 1.35; transition: transform 180ms ease, opacity 180ms ease; }
  .share-button:hover svg, .share-button:focus-visible svg { transform: translateY(-2px); }
  .share-button:focus-visible { outline: 1px solid currentColor; outline-offset: 4px; }
  .share-badge { position: absolute; right: 0; bottom: calc(100% + 9px); z-index: 2; padding: 8px 11px; border: 1px solid var(--site-line); background: var(--site-surface); color: var(--site-ink); font-size: .75rem; line-height: 1; opacity: 0; pointer-events: none; transform: translateY(4px); transition: opacity 180ms ease, transform 180ms ease; white-space: nowrap; }
  .share-badge.is-visible { opacity: 1; transform: translateY(0); }
  .share-badge[hidden] { display: block; }
</style>
